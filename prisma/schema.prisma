generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Channel {
  id            String    @id @default(uuid())
  name          String
  type          String
  enabled       Boolean   @default(true)
  minConfidence Float     @default(0.8)
  maxTrades     Int       @default(5)
  riskLevel     String    @default("MEDIUM")
  webhook_url   String?
  lastAnalyzed  DateTime?

  // 🔽 Add these fields for stats tracking
  totalTrades Int   @default(0)
  winRate     Float @default(0)
  avgProfit   Float @default(0)
  performance Float @default(0)

  mode String @default("manual")

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  marketUpdates      MarketUpdate[]
  messages           Message[]
  performanceHistory PerformanceHistory[]
  trades             Trade[]
  traderStats        TraderStats[]
  callouts           Callout[]
}

model Trade {
  id          String    @id @default(uuid())
  symbol      String
  action      String
  optionType  String?
  strikePrice Float?
  entryPrice  Float
  exitPrice   Float?
  quantity    Int
  author      String?
  mode        String    @default("SIMULATED")
  status      String
  entryTime   DateTime  @default(now())
  exitTime    DateTime?
  profitLoss  Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Channel relationship
  channel   Channel @relation(fields: [channelId], references: [id])
  channelId String

  // ✅ One-to-one relation
  executionStats     ExecutionStats?
  signals            TradeSignal[]
  executionAuditLogs ExecutionAuditLog[] @relation("TradeToAuditLog")
  calloutId          String?             @unique
  callout            Callout?            @relation(fields: [calloutId], references: [id])
  priceSnapshots     PriceSnapshot[]
}

model Message {
  id           String        @id @default(uuid())
  channelId    String
  discordId    String        @unique
  author       String
  content      String
  parsedData   String?
  type         String
  modelUsed    String?
  parsedAt     DateTime?
  createdAt    DateTime      @default(now())
  manualLabels ManualLabel[]
  channel      Channel       @relation(fields: [channelId], references: [id])
  modelLogs    ModelLog[]
  traderStats  TraderStats?  @relation(fields: [author, channelId], references: [author, channelId])
}

model PriceSnapshot {
  id         String         @id @default(uuid())
  symbol     String
  source     String
  price      Float
  recordedAt DateTime       @default(now())
  metadata   String?
  calloutId  String?
  tradeId    String?
  callout    Callout?       @relation(fields: [calloutId], references: [id])
  trade      Trade?         @relation(fields: [tradeId], references: [id])
  matches    CalloutMatch[]
}

model Callout {
  id              String          @id @default(uuid())
  source          String
  sourceMessageId String?
  sourceChannelId String?
  channelId       String?
  channelName     String?
  traderName      String?
  assetType       String          @default("EQUITY")
  symbol          String
  action          String?
  strikePrice     Float?
  expirationDate  DateTime?
  optionType      String?
  targetEntry     Float?
  targetExit      Float?
  quantity        Int?
  confidence      Float?
  status          String          @default("PENDING")
  notes           String?
  rawMessage      String?
  rawAnalysis     String?
  calloutAt       DateTime        @default(now())
  matchedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  channel         Channel?        @relation(fields: [channelId], references: [id])
  trade           Trade?
  matches         CalloutMatch[]
  snapshots       PriceSnapshot[]

  @@index([symbol])
  @@index([status])
}

model CalloutMatch {
  id              String         @id @default(uuid())
  calloutId       String
  matchType       String         @default("CALLOUT")
  quoteSource     String         @default("robinhood")
  priceSnapshotId String?
  symbol          String
  referencePrice  Float?
  bidPrice        Float?
  askPrice        Float?
  markPrice       Float?
  instrumentId    String?
  quoteTimestamp  DateTime       @default(now())
  latencyMs       Int?
  createdAt       DateTime       @default(now())
  callout         Callout        @relation(fields: [calloutId], references: [id])
  priceSnapshot   PriceSnapshot? @relation(fields: [priceSnapshotId], references: [id])

  @@index([calloutId])
}

model InstrumentCache {
  id             String    @id @default(uuid())
  symbol         String
  assetType      String    @default("EQUITY")
  strikePrice    Float?
  optionType     String?
  expirationDate DateTime?
  instrumentUrl  String?
  chainId        String?
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([symbol, strikePrice, optionType, expirationDate])
}

model MarketUpdate {
  id        String   @id @default(uuid())
  channelId String
  messageId String   @unique
  summary   String
  sentiment String
  symbol    String?
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id])
}

model MarketCalendar {
  id        String   @id @default(uuid())
  eventDate DateTime
  title     String
  source    String
  createdAt DateTime @default(now())
}

model ModelLog {
  id           String   @id @default(uuid())
  messageId    String
  prompt       String
  response     String
  inputTokens  Int
  outputTokens Int
  latencyMs    Int
  modelName    String
  createdAt    DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id])
}

model ManualLabel {
  id         String   @id @default(uuid())
  messageId  String
  label      String
  source     String
  confidence Float
  labeledAt  DateTime @default(now())
  message    Message  @relation(fields: [messageId], references: [id])
}

model TradeSignal {
  id           String   @id @default(uuid())
  tradeId      String
  confidence   Float
  triggeredAt  DateTime
  source       String
  autoExecuted Boolean  @default(false)
  createdAt    DateTime @default(now())
  trade        Trade    @relation(fields: [tradeId], references: [id])
}

model ExecutionStats {
  id             String   @id @default(uuid())
  tradeId        String   @unique // ✅ enforce 1-to-1
  executedAt     DateTime
  executedPrice  Float
  exitPrice      Float?
  exitConfidence Float?
  result         String
  pnl            Float?
  durationSec    Int?
  createdAt      DateTime @default(now())
  trade          Trade    @relation(fields: [tradeId], references: [id])
}

model PerformanceHistory {
  id          String   @id @default(uuid())
  channelId   String
  period      String
  startDate   DateTime
  endDate     DateTime
  totalTrades Int
  winRate     Float
  avgProfit   Float
  performance Float
  createdAt   DateTime @default(now())
  channel     Channel  @relation(fields: [channelId], references: [id])
}

model OrderRecord {
  id            String    @id @default(uuid())
  brokerOrderId String    @unique
  symbol        String
  type          String?
  side          String?
  quantity      Int
  price         Float?
  status        String?
  filledAt      DateTime?
  createdAt     DateTime  @default(now())
}

model ChannelConfig {
  id            String   @id @default(uuid())
  channelId     String   @unique
  isEnabled     Boolean  @default(true)
  minConfidence Float    @default(0.7)
  maxTrades     Int      @default(5)
  riskLevel     String   @default("MEDIUM")
  updatedAt     DateTime @updatedAt
}

model TraderStats {
  id                String    @id @default(uuid())
  author            String // Discord username/ID
  channelId         String
  channel           Channel   @relation(fields: [channelId], references: [id])
  totalSignals      Int       @default(0)
  successfulSignals Int       @default(0)
  avgConfidence     Float     @default(0)
  avgProfitLoss     Float     @default(0)
  bestSymbols       String    @default("[]") // JSON string: [{symbol, winRate, totalTrades}]
  tradingHours      String    @default("[]") // JSON string: [{hour, winRate, totalTrades}]
  lastActive        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  messages          Message[] // Relation to messages from this trader

  @@unique([author, channelId])
}

model BotStats {
  id        String   @id @default(uuid())
  period    String // "DAILY", "WEEKLY", "MONTHLY", "ALL_TIME"
  startDate DateTime
  endDate   DateTime

  // Basic Performance Metrics
  totalTrades      Int   @default(0)
  successfulTrades Int   @default(0)
  totalProfitLoss  Float @default(0)
  avgProfitLoss    Float @default(0)
  winRate          Float @default(0)
  avgConfidence    Float @default(0)
  avgTradeDuration Int   @default(0) // in seconds

  // Advanced Performance Metrics
  profitFactor         Float @default(0) // Total profit / Total loss
  expectancy           Float @default(0) // (Win% * Avg Win) - (Loss% * Avg Loss)
  maxConsecutiveWins   Int   @default(0)
  maxConsecutiveLosses Int   @default(0)
  avgWinAmount         Float @default(0)
  avgLossAmount        Float @default(0)
  largestWin           Float @default(0)
  largestLoss          Float @default(0)

  // Time-based Analysis
  bestTradingHour   Int? // 0-23
  worstTradingHour  Int? // 0-23
  bestTradingDay    Int? // 0-6 (Sunday-Saturday)
  worstTradingDay   Int? // 0-6
  avgTradesPerDay   Float     @default(0)
  busiestTradingDay DateTime?

  // Asset Class Analysis
  optionsRatio   Float @default(0) // Ratio of options trades
  stockRatio     Float @default(0) // Ratio of stock trades
  cryptoRatio    Float @default(0) // Ratio of crypto trades
  optionsWinRate Float @default(0)
  stockWinRate   Float @default(0)
  cryptoWinRate  Float @default(0)

  // Risk Metrics
  maxDrawdown       Float @default(0)
  sharpeRatio       Float @default(0)
  sortinoRatio      Float @default(0)
  calmarRatio       Float @default(0)
  var95             Float @default(0) // 95% Value at Risk
  expectedShortfall Float @default(0) // Conditional VaR

  // Channel Analysis
  totalChannels          Int     @default(0)
  activeChannels         Int     @default(0)
  bestPerformingChannel  String? // Channel ID
  worstPerformingChannel String?
  channelWinRates        String  @default("[]") // JSON string array
  channelProfitLoss      String  @default("[]") // JSON string array

  // Trader Analysis
  totalTraders          Int     @default(0)
  activeTraders         Int     @default(0)
  bestPerformingTrader  String? // Trader username
  worstPerformingTrader String?
  traderWinRates        String  @default("[]") // JSON string array
  traderProfitLoss      String  @default("[]")

  // Symbol Analysis
  mostTradedSymbol  String?
  symbolStats       String  @default("[]") // JSON string array
  sectorPerformance String  @default("[]")

  // Signal Quality
  avgSignalLatency    Int    @default(0) // Time between signal and execution
  signalAccuracy      Float  @default(0) // How often signals lead to profitable trades
  falsePositiveRate   Float  @default(0) // Rate of unprofitable signals
  avgConfidenceByType String @default("{}") // JSON string map

  // System Health
  uptime              Float  @default(0) // Percentage of time system is active
  errorRate           Float  @default(0) // Rate of system errors
  avgProcessingTime   Int    @default(0) // Average time to process signals
  resourceUtilization String @default("{}") // JSON string map

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExecutionAuditLog {
  id          String   @id @default(uuid())
  tradeId     String
  channelId   String?
  type        String
  statusCode  Int?
  rawResponse String?  @default("{}")
  durationMs  Int?
  timestamp   DateTime @default(now())
  Trade       Trade    @relation("TradeToAuditLog", fields: [tradeId], references: [id])
}

model JobLog {
  id        String    @id @default(uuid())
  jobName   String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  status    String
  errorText String?
}

model ModelEvalResult {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  totalTested   Int
  truePositive  Int
  trueNegative  Int
  falsePositive Int
  falseNegative Int
  modelVersion  String
  notes         String?
}
