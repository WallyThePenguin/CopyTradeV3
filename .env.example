DISCORD_TOKEN=your_discord_token
DISCORD_CALLOUT_COPY=your_discord_channel_id
WEBHOOK_URL=https://example.com/webhook
ROBINHOOD_USERNAME=your_username
ROBINHOOD_PASSWORD=your_password
ROBINHOOD_TOKEN=your_saved_token
DEFAULT_QUANTITY=1
MAX_QUANTITY=1

# API key for securing POST routes
API_KEY=your_api_key
# Admin dashboard password
ADMIN_PASSWORD=your_admin_password

# Environment Setting
ENVIRONMENT=TESTING

# Path to market news feed (file or URL)
NEWS_FEED_PATH=data/news/sample_news.json

# Web server port
WEB_PORT=3000

# Cron schedule for data quality checks (CRON format)
DATA_QUALITY_SCHEDULE=0 4 * * *

# Minimum confidence score (0-1) required for regex exit detection
CONFIDENCE_THRESHOLD=0.8
CONFIDENCE_BASE=0.7
CONFIDENCE_STEP=0.05

# Model Configuration
MODEL_NAME=MISTRAL
MISTRAL_MODEL_PATH=/path/to/model/mistral-7b-instruct-v0.2.Q4_K_M.gguf

# Local development uses SQLite stored inside data/dev.db
DATABASE_URL="file:./data/dev.db"

# Optional CUDA runtime hint for llama-cpp (set to your installed toolkit)
CUDA_PATH="C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.4"

# When ENVIRONMENT=TESTING you can still fetch live Robinhood quotes
USE_LIVE_MARKET_DATA=true

# Optional: pre-provisioned Robinhood device token (else generated automatically)
# ROBINHOOD_DEVICE_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: direct access token (used if present to skip login)
# ACCESS_TOKEN=your_direct_access_token
